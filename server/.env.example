# Copy this file to server/.env and fill in your values. Never commit server/.env.
PORT=3001

# "gemini" uses the Gemini API; "mock" returns sample papers without any AI call.
# If left empty, gemini is used when GEMINI_API_KEY is set, otherwise mock.
AI_PROVIDER=

GEMINI_API_KEY=
# Any model that supports generateContent. Check the Gemini docs for current model IDs.
GEMINI_MODEL=gemini-2.5-flash
